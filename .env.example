# Public CTA label. Use "demo" or "waitlist".
# This value is baked into the browser bundle. Change it, then rebuild.
NEXT_PUBLIC_CTA_MODE=demo

# Show proposed starting prices on pricing cards. Set to "false" to show "Talk to us".
# Baked into the browser bundle. Change it, then rebuild.
NEXT_PUBLIC_SHOW_PRICES=true

# Optional published contact address. Leave blank until a real inbox exists.
# Shown on the contact page and footer only when it is a valid email.
CONTACT_EMAIL=

# How demo inquiries are delivered: webhook, email, database, or local.
# Development with an empty value uses local mode and says so on the form.
# Production with an empty or local value refuses the submission.
# Production never shows a success message unless delivery actually succeeds.
FORM_DELIVERY=

# Webhook. HTTPS is required in production. HTTP is allowed only in development.
FORM_WEBHOOK_URL=
# Optional bearer token sent as Authorization: Bearer <secret>
FORM_WEBHOOK_SECRET=

# Email delivery uses the Resend HTTP API. All three values are required.
RESEND_API_KEY=
FORM_EMAIL_FROM=
FORM_EMAIL_TO=

# Postgres connection string for FORM_DELIVERY=database.
# Create the table in db/demo_requests.sql before enabling this mode.
DATABASE_URL=

# Optional analytics. Both values are required, and the script loads only
# after a visitor clicks Allow analytics. Leave both blank to disable it.
# NEXT_PUBLIC_ values are visible in the browser.
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_SRC=
